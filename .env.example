# Kopieer naar .env als de standaardpoorten bezet zijn, of als je rust wilt.
FRONTEND_PORT=3004
API_PORT=8084
DB_PORT=5436

# De UI rolt elk kwartier een nieuwe revisie uit. Zet op false tijdens het bouwen.
UI_DRIFT_ENABLED=true
UI_DRIFT_INTERVAL_MINUTES=15
UI_START_REVISION=1

# Wisselende responstijden, inschuivende banner, doordraaiende carousel en een
# videorondleiding die per fragment anders lang duurt.
FLAKINESS_ENABLED=true
FLAKINESS_MIN_MS=40
FLAKINESS_MAX_MS=1800
